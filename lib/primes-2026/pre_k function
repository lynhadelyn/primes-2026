import itertools

#Find pre_k for a given partion (list) as its input
def pre(k,list1):
  return_partition=[]
  list2=list(itertools.combinations(list1,k))
  for i in range(0,len(list2)):
    count=1
    for j in range(0,len(list2[i])):
      count*=list2[i][j]

    return_partition.append(count)

  return_partition.sort(reverse=True)
  return return_partition

