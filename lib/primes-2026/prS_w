%An experimentation with the function prS_w, which was the analog of pre_k, but over Schubert polynomials
%NOTE: This function was not mentioned in the final paper

def summands(poly, vals):
    result = []
    for exps, c in poly.dict().items():
        poly_temp = 1
        for i, e in enumerate(exps):
            poly_temp*=vals[i]**e
           
        result.extend([poly_temp]*int(c))
    return sorted(result, reverse=True)

def prS(lam,w):
    X=SchubertPolynomialRing(ZZ)
    poly=X(w).expand()
    return summands(poly,lam)

def prS_injectivity(n,w,mlen):
    lambdas = Partitions(n, min_length = mlen)
    lambda_new=[]
    for p in lambdas:
        if len(p) == len(w)-1:
            lambda_new.append(tuple(p) + (0,))
        else:
            lambda_new.append(tuple(p))
    outputs = []
    for lam in lambda_new:
        prSw = prS(lam,w)
        if prSw in outputs:
            #print(lam)
            #print(f"Injectivity fails with {n}, prS{w}, partition length {len(lam)}, and output {prSw}")
            return False
        outputs.append(prSw)
    return True


    


#Checks for number of times injectivity holds for each w
m=4
P=Permutations(m)
poset_count=[]
for w in P:
    poset_count.append(0)
    for n in range(m-1,10):
            #print(f"w = {w}, n = {n}, partition length = {mlen}")
            #print(prS_injectivity(n,w,mlen))
            if prS_injectivity(n,w,m-1):
                poset_count[-1]+=1
    if poset_count[-1]==1:
        poset_count[-1]-=1
    print(f"Permutation {w} is injective {poset_count[-1]} times.")

