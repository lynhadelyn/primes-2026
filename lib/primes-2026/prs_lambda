%Return summands of s_lambda
def summands(poly, vals):
    result = []
    for exps, c in poly.dict().items():
        poly_temp = 1
        for i, e in enumerate(exps):
            poly_temp*=vals[i]**e
           
        result.extend([poly_temp]*int(c))
    return sorted(result, reverse=True)

%Find prs_{lambda_1}(lambda_2)
def prs(lambda1, lambda2):
    s=SymmetricFunctions(QQ).s()
    poly=s(lambda1).expand(len(lambda2))
    return_partition=summands(poly,lambda2)
    return return_partition
    
