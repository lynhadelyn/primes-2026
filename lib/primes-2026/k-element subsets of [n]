def subsetsizek(k,n):
  return_list=[]
  if n==1:
    if k==0:
      return_list.append([])
    else:
      return_list.append([1])
  elif k==0:
    return_list.append([])

  else:
    if k<n:
      list1=subsetsizek(k,n-1)
      for i in range(0,len(list1)):
        return_list.append(list1[i])

      list2=subsetsizek(k-1,n-1)
      for i in range(0,len(list2)):
        list2[i].append(n)
        return_list.append(list2[i])

    else:
      my_list=[]
      for i in range(1,n+1):
        my_list.append(i)
      return_list.append(my_list)

  return return_list
